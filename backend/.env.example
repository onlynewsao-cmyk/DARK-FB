# ===========================================
# DARK-FB - Facebook Bot Professional Configuration
# ===========================================

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=5000
NODE_ENV=development

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# MongoDB Atlas or local MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dark-fb?retryWrites=true&w=majority

# Redis for rate limiting and caching (optional)
REDIS_URL=redis://localhost:6379

# ===========================================
# JWT CONFIGURATION
# ===========================================
JWT_SECRET=your_super_secure_jwt_secret_key_here_1234567890
JWT_EXPIRES_IN=30d

# ===========================================
# FACEBOOK API CONFIGURATION
# ===========================================
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_ACCESS_TOKEN=your_facebook_long_lived_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_GROUP_ID=your_facebook_group_id

# Facebook Webhook
FACEBOOK_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here
FACEBOOK_CALLBACK_URL=https://your-domain.com/api/auth/facebook/callback

# ===========================================
# OAUTH PROVIDERS (Multi-Provider Login)
# ===========================================

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-domain.com/api/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://your-domain.com/api/auth/github/callback

# ===========================================
# SESSION CONFIGURATION
# ===========================================
SESSION_SECRET=your_session_secret_key_here
SESSION_COOKIE_NAME=dark-fb-session
SESSION_COOKIE_MAX_AGE=86400000 # 24 hours in ms

# ===========================================
# EMAIL CONFIGURATION (Optional)
# ===========================================

# SMTP Configuration (for password reset, notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password_or_app_password
SMTP_FROM=noreply@dark-fb.com

# SendGrid Configuration (Alternative)
SENDGRID_API_KEY=your_sendgrid_api_key

# Mailgun Configuration (Alternative)
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your_mailgun_domain

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
FRONTEND_URL=http://localhost:3000

# ===========================================
# RENDER CONFIGURATION (Production)
# ===========================================
RENDER_URL=https://dark-fb-api.onrender.com
RENDER_DASHBOARD_URL=https://dark-fb-dashboard.onrender.com

# ===========================================
# UPTIME MONITORING
# ===========================================
UPTIME_ROBOT_API_KEY=your_uptime_robot_api_key

# ===========================================
# RATE LIMITING & ANTI-BAN
# ===========================================
# Enable rate limiting
RATE_LIMIT_ENABLED=true

# Enable proxy rotation (for anti-ban)
PROXY_ENABLED=false
# Comma-separated list of proxies
# PROXIES=http://proxy1:port,http://proxy2:port,socks5://proxy3:port

# Max posts per hour per user (anti-ban)
MAX_POSTS_PER_HOUR=50

# Max messages per minute per user (anti-ban)
MAX_MESSAGES_PER_MINUTE=20

# Random delay between requests (ms)
RANDOM_DELAY_MIN=1000
RANDOM_DELAY_MAX=5000

# ===========================================
# SECURITY CONFIGURATION
# ===========================================

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,https://dark-fb-dashboard.onrender.com
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_CREDENTIALS=true

# Helmet Security Headers
HELMET_ENABLED=true

# CSRF Protection
CSRF_ENABLED=true
CSRF_SECRET=your_csrf_secret_key_here

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_LEVEL=info
LOG_FILES_ENABLED=true

# ===========================================
# ANALYTICS & TRACKING
# ===========================================
GOOGLE_ANALYTICS_ID=your_google_analytics_id

# ===========================================
# PAYMENT CONFIGURATION (Future)
# ===========================================
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# ===========================================
# NOTIFICATIONS
# ===========================================

# Firebase Cloud Messaging (for push notifications)
FCM_SERVER_KEY=your_fcm_server_key

# Slack Webhook for alerts
SLACK_WEBHOOK_URL=your_slack_webhook_url

# ===========================================
# FEATURE FLAGS
# ===========================================

# Enable multi-provider authentication
MULTI_PROVIDER_AUTH=true

# Enable email verification
EMAIL_VERIFICATION=true

# Enable anti-ban protection
ANTI_BAN_ENABLED=true

# Enable analytics
ANALYTICS_ENABLED=true

# Enable real-time notifications
REALTIME_NOTIFICATIONS=true

# Enable scheduled posts
SCHEDULED_POSTS=true

# ===========================================
# EXAMPLE: Production Configuration
# ===========================================
# When deploying to production, use:
# NODE_ENV=production
# PORT=10000
# MONGODB_URI=mongodb+srv://prod_user:prod_password@cluster0.mongodb.net/dark-fb?retryWrites=true&w=majority
# JWT_SECRET=your_production_jwt_secret
# FRONTEND_URL=https://dark-fb-dashboard.onrender.com
# RENDER_URL=https://dark-fb-api.onrender.com
# CORS_ORIGIN=https://dark-fb-dashboard.onrender.com
