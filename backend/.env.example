# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/facebook-bot?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d

# Facebook API Configuration
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_GROUP_ID=your_facebook_group_id

# Facebook Webhook
FACEBOOK_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Render Configuration (for production)
RENDER_URL=https://facebook-bot.onrender.com

# Uptime Monitoring
UPTIME_ROBOT_API_KEY=your_uptime_robot_api_key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
